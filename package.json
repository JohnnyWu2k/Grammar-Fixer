{
  "name": "grammar-fixer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests/unit",
    "check": "bun run typecheck && bun run test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-grammar-fixer \"bun test ./tests/security\"",
    "deploy:hosting": "firebase deploy --only hosting:web",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/bun": "^1.4.4",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.36.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
